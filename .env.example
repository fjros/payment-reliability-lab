# Every value here is an obviously synthetic LOCAL DEMO default and matches the built-in defaults,
# so the demo runs with no configuration at all. To change one, export it in your shell (Node does
# not read .env files by itself) or run commands with `node --env-file=.env ...`.
# Real secrets never belong in this repository.
PRL_PG_HOST=127.0.0.1
PRL_PG_PORT=54329
PRL_PG_ADMIN_USER=postgres
PRL_PG_ADMIN_PASSWORD=local-demo-admin
PRL_APP_DB=prl_demo_app
PRL_PROVIDER_DB=prl_demo_provider
PRL_APP_DB_PASSWORD=local-demo-app
PRL_MCP_DB_PASSWORD=local-demo-mcp-readonly
PRL_PROVIDER_DB_PASSWORD=local-demo-provider
PRL_API_PORT=4010
PRL_PROVIDER_PORT=4020
PRL_WEBHOOK_SECRET=local-demo-webhook-secret-not-for-production
# Synthetic runs the read-only MCP server may disclose:
PRL_MCP_RUN_IDS=S1-1,S2-1,S3-1,S7-1,S8-1
