{
  "name": "payment-reliability-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Synthetic payment reliability lab: safe retries, duplicate/out-of-order webhooks, unknown provider outcomes and a read-only MCP investigation workflow.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjros/payment-reliability-lab.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "scripts": {
    "dev": "node src/dev.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node src/db/cli.ts migrate",
    "demo:seed": "node src/db/cli.ts seed",
    "demo:reset": "node src/db/cli.ts reset",
    "demo:scenario": "node src/scenarios/run.ts",
    "demo:export": "node src/scenarios/export.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:mcp": "npm run build:server && vitest run --project mcp",
    "test:e2e": "npm run build:web && playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:mcp && npm run test:e2e",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "mcp": "node dist/mcp/main.js",
    "openapi": "node src/api/openapi.ts",
    "build:public": "vite build --config web/vite.config.ts --mode public",
    "test:public": "npm run build:public && PRL_PUBLIC_REPLAY=true playwright test"
  }
}
